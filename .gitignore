.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Derived arrays — regenerable by rerunning calcs/sentinel_wedge.py in ~10 min.
# 18 MB each; they were bloating every clone for no benefit.
output/*.npy

# Third-party screenshots used for measurement during the analysis:
# Google Earth / Google Maps imagery, and news-media stills credited to
# @vantortech via Republic Digital. NOT ours to redistribute. Kept locally,
# never committed. The measurements taken from them are in the dossier with
# their provenance.
screenshot-*.png

# Video forensics: keep the METHOD, never the third-party footage. Downloaded
# clips and extracted frames are not ours to redistribute — the same rule
# PUBLISHING.md applies to the @vantortech stills. The measurements taken from
# them, with provenance, live in research/event-dossier.md.
research/video/*
!research/video/*.sh
!research/video/*.py
!research/video/*.md
